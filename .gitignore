# Môi trường ảo (Virtual Environments)
venv/
env/
.venv/

# File tạm và cache của Python
__pycache__/
*.py[cod]
*$py.class

# File cấu hình của các IDE/Editor (VS Code, PyCharm...)
.vscode/
.idea/
*.swp

# File rác của hệ điều hành
.DS_Store
Thumbs.db

# Các file tạm được sinh ra trong quá trình biên dịch LaTeX (dành cho phần Báo cáo sau này)
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.fls
report/*.fdb_latexmk
report/*.synctex.gz
report/*.bbl
report/*.blg
report/*.xdv
report/*.abs
report/*.bcf
report/*.run.xml

# Thư mục tạm khi render PDF sang ảnh để kiểm tra
results/_new/
results/_check/

# File kiểm tra tạm thời
report/_check.py
results/_verify.py
*_run.log
*_err.log

# File cài đặt phần mềm (kích thước lớn, không nên lưu trong repo)
*.msi
*.exe

# File backup dữ liệu thực nghiệm
*_BACKUP.csv
*.OLD_BACKUP.csv
